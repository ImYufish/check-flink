.env

# 本地友链数据（不提交，保护隐私）
link.csv

# friends_watcher 生成的临时文件 / 数据
friends.json
friends_snapshot.json
_debug_repaired.json

# 例外：static/friends.json 是友链远程清单真源，必须提交（与上面的 friends.json 区分）
!static/friends.json

# 运行产物（不提交，CI 重新生成）
result.json
result.baseline.json

# Python 编译缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 诊断日志（不提交，临时文件）
run_log.txt
*.log

# Trae/Cursor IDE 临时文件
.trae/
.cursor/